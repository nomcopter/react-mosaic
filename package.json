{
  "name": "react-mosaic-component",
  "version": "0.0.1",
  "description": "A React Tiling Window Manager",
  "license": "Apache-2.0",
  "keywords": [
    "ui",
    "react",
    "component",
    "typescript",
    "tiling-window-manager",
    "window-manager"
  ],
  "scripts": {
    "nx": "nx",
    "start": "npx nx run website:start",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:package": "node --test tools/package-tests/package-exports.test.mjs",
    "format": "nx format:write",
    "update": "cross-env NX_SKIP_PROVENANCE_CHECK=true npx nx migrate latest && npm install && npx nx migrate --run-migrations --ifExists",
    "build:site": "npx nx run website:build",
    "build:lib": "npm-run-all clean -lp build-lib:** && run-s copy",
    "build-lib:less": "lessc --autoprefix=defaults ./libs/react-mosaic-component/src/lib/styles/index.less ./dist/libs/react-mosaic-component/react-mosaic-component.css",
    "build-lib:js": "tsup",
    "build-lib:check": "tsc -p ./libs/react-mosaic-component/tsconfig.lib.json --noEmit",
    "build-lib:types": "tsup --dts-only",
    "clean": "shx rm -rf ./dist/libs/react-mosaic-component/",
    "copy": "shx mv ./dist/libs/react-mosaic-component/index.d.ts ./dist/libs/react-mosaic-component/index.d.cts && shx cp ./libs/react-mosaic-component/package.json ./dist/libs/react-mosaic-component/package.json && shx cp README.md ./dist/libs/react-mosaic-component/README.md && shx cp LICENSE ./dist/libs/react-mosaic-component/LICENSE && shx cp -r skills ./dist/libs/react-mosaic-component/skills",
    "prepare": "lefthook install",
    "release": "npm run lint && npm run test && nx release --verbose --skip-publish",
    "remediate": "npx npm-check-updates -i"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "dnd-core": "16.0.1",
    "immutability-helper": "^3.1.1",
    "lodash-es": "^4.18.1",
    "rdndmb-html5-to-touch": "^9.0.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-multi-backend": "^9.0.0",
    "react-dnd-touch-backend": "^16.0.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@blueprintjs/core": "^5.7.0",
    "@blueprintjs/icons": "^5.19.1",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-classic": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/theme-live-codeblock": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@eslint/js": "^9.8.0",
    "@mdx-js/react": "^3.1.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@swc/helpers": "0.5.23",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/classnames": "^2.3.4",
    "@types/dom4": "^2.0.4",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "ajv": "^8.20.0",
    "cross-env": "7.0.3",
    "css-loader": "^6.7.3",
    "docusaurus-plugin-llms": "^0.6.0",
    "docusaurus-plugin-typedoc": "^1.4.3",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "jiti": "2.7.0",
    "jsdom": "~22.1.0",
    "jsdom-global": "^3.0.2",
    "lefthook": "^2.1.14",
    "less": "^3.13.1",
    "less-plugin-autoprefix": "^2.0.0",
    "mock-require": "^3.0.3",
    "npm-run-all2": "8.0.4",
    "nx": "23.2.1",
    "nx-github-pages": "^1.3.1",
    "prettier": "3.9.9",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-refresh": "^0.19.0",
    "shx": "0.4.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "verdaccio": "6.10.4",
    "vite": "8.3.1",
    "vite-plugin-dts": "~4.5.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "16 - 19"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
